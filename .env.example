# ---- MuleWatch command center (runs on your laptop) ----
# Public forum to monitor (your server)
FORUM_URL=http://103.155.85.18:8100
# Must match FORUM_MOD_TOKEN on the forum server (used for "Request takedown")
FORUM_MOD_TOKEN=skit-cybercell-2026
# Crawl interval in seconds
CRAWL_INTERVAL=3

# Optional: Telegram bot (create one with @BotFather).
#  - Critical alerts to your phone: send /alerts <code> to the bot (code shown on Monitored sources),
#    or set TELEGRAM_CHAT_ID here
#  - the same bot also becomes the citizen reporting bot (people forward suspicious ads to it)
#  - set REPORT_BOT_TOKEN only if you want a separate bot for citizen reports
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_BOT_TOKEN=
REPORTS_PER_HOUR=30
ALERT_MIN_LEVEL=Critical
PUBLIC_BASE_URL=http://localhost:8000

# Optional: Claude "AI analyst" second opinion for manual submissions
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# ---- Police workflow ----
# Demo accounts analyst / io / sho (password mule@2026) are created on first start. Set to 0 to skip them,
# then add real users with:  cd backend && ../.venv/bin/python -m app.users add <username> <ROLE> "<Name>"
MW_DEMO_USERS=1
SESSION_HOURS=12
# Shared key the Chrome extension sends to submit posts (it can do nothing else). Leave empty to disable.
MW_INGEST_KEY=
# Platform's removal window after a notice is marked sent (IT Rules amendment of Feb 2026: 3 hours)
TAKEDOWN_WINDOW_HOURS=3
TAKEDOWN_WARN_MINUTES=30
# Daily brief to supervisors on Telegram (IST)
DAILY_BRIEF_TIME=09:00
DAILY_BRIEF_LANG=en
DAILY_BRIEF_TELEGRAM=1
# Full-page screenshots of High/Critical cases (needs: pip install playwright && playwright install chromium)
MW_SCREENSHOTS=1
# Bulk link check: links per list, and seconds between links
BULK_MAX_LINKS=500
BULK_PAUSE_SECONDS=1.5
# Optional: give the keys yourself instead of the generated files in backend/data/keys/
# MW_SECRET=
# MW_DATA_KEY=
