# Copy to research/.env (git-ignored). Never commit the real file.
# Telegram API credentials from https://my.telegram.org -> API development tools.
# Use a dedicated research account, not a personal one.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Where Telethon keeps its login session (git-ignored).
TELEGRAM_SESSION=store/telegram_research.session

# Secret salt for the keyed hashes of phone numbers, UPI IDs, accounts etc.
# Generate once:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep it out of any released dataset; changing it breaks entity linking across runs.
RESEARCH_HASH_SALT=

# OpenAI-compatible endpoint for the LLM baseline and paraphrase attack (vLLM or Ollama).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=not-needed-for-local

# Optional: Label Studio, for pushing and pulling annotation batches through the API.
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
